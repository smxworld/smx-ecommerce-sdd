<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
        The parent reference of a JPA child entity (item -> cart/order) is a bidirectional association:
        it is meant to be exposed and set by the aggregate root, so EI_EXPOSE_REP/REP2 are false positives.
    -->
    <Match>
        <Or>
            <Class name="com.smxworld.ecommerce.cart.internal.model.CartItemEntity"/>
            <Class name="com.smxworld.ecommerce.order.internal.model.OrderItemEntity"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
